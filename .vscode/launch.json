{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chatbot: Local development",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "APP_ENV": "development",
                "APP_HOST": "127.0.0.1"
            }
        }
    ]
}
